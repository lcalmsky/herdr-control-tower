#!/bin/sh
# cca — Claude Code accounts: list them, run claude under one, add an account,
# and share session history between accounts.

set -u

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower/usage"
SHARED="projects history.jsonl file-history todos plans tasks teams paste-cache session-env sessions"

die() { printf 'cca: %s\n' "$*" >&2; exit 1; }

reserved_name() {
  case "$1" in ls|add|share|help|'-'*) return 0 ;; esac
  return 1
}

valid_name() {
  case "$1" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
  reserved_name "$1" && return 1
  return 0
}

acct_name() {
  case "$1" in
    "$HOME/.claude") printf 'default\n' ;;
    "$HOME"/.claude-accounts/*) b=${1%/}; printf '%s\n' "${b##*/}" ;;
    *) b=${1%/}; printf '%s\n' "${b##*/}" ;;
  esac
}

current_account() {
  d=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  d=${d%/}
  acct_name "$d"
}

email() {
  if [ -f "$1" ]; then
    e=$(grep -o '"emailAddress"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" 2>/dev/null | head -n 1 | sed 's/.*:[[:space:]]*"//; s/"$//')
    if [ -n "$e" ]; then printf '%s\n' "$e"; return; fi
  fi
  printf 'not signed in\n'
}

val() {
  printf '%s' "$1" | grep -o "\"$2\":[0-9][0-9.]*" 2>/dev/null | head -n 1 | cut -d: -f2
}

# "used resets_at" for one window, with a window past its reset read as 0 %.
usage_get() {
  f="$STATE/$1.json"
  [ -f "$f" ] || return 1
  obj=$(grep -o "\"$2\":{[^}]*}" "$f" 2>/dev/null | head -n 1)
  [ -n "$obj" ] || return 1
  used=$(val "$obj" used)
  [ -n "$used" ] || return 1
  reset=$(val "$obj" resets_at)
  if [ -n "$reset" ] && [ "$reset" -le "$(date +%s)" ] 2>/dev/null; then
    printf '0 \n'
  else
    printf '%s %s\n' "$used" "$reset"
  fi
}

hhmm() {
  if date -r "$1" +%H:%M >/dev/null 2>&1; then
    date -r "$1" +%H:%M
  else
    date -d "@$1" +%H:%M 2>/dev/null
  fi
}

pct_of() { printf '%.0f' "$1" 2>/dev/null || printf '%s' "$1"; }

# One cell of the table, padded to $3 columns: "12%", "94% ↻15:20" or "–". The ↻ and – are
# multibyte but one column each, so the width is counted from the parts rather than with ${#}.
usage_cell() {
  width=$3
  if ! vals=$(usage_get "$1" "$2"); then
    printf '–'
    n=$((width - 1))
  else
    used=${vals%% *}
    reset=${vals#* }
    pct=$(pct_of "$used")
    if [ -n "$reset" ] && [ "$pct" -ge 90 ] 2>/dev/null; then
      printf '%s%% ↻%s' "$pct" "$(hhmm "$reset")"
      n=$((width - ${#pct} - 8))
    else
      printf '%s%%' "$pct"
      n=$((width - ${#pct} - 1))
    fi
  fi
  while [ "$n" -gt 0 ]; do printf ' '; n=$((n - 1)); done
}

# Resets only exist when the terminal (and the person) can show color.
color=
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  OFF=$(printf '\033[0m')
  BOLD=$(printf '\033[1m')
  DIM=$(printf '\033[2m')
  AMBER=$(printf '\033[33m')
  RED=$(printf '\033[31m')
else
  OFF= BOLD= DIM= AMBER= RED=
fi

cmd_ls() {
  cur=$(current_account)
  best_name=
  best_used=
  printf '%s  %-11.11s %-21.21s %-11.11s %-11.11s%s\n' "$DIM" "NAME" "EMAIL" "5H" "7D" "$OFF"
  row() {
    printf '%s%-1.1s%s ' "$AMBER" "$3" "$OFF"
    printf '%s%-11.11s%s ' "$BOLD" "$1" "$OFF"
    printf '%s%-21.21s%s ' "$DIM" "$2" "$OFF"
    printf '%s' "$4"; usage_cell "$1" five_hour 11; printf '%s ' "$OFF"
    printf '%s' "$DIM"; usage_cell "$1" seven_day 11; printf '%s\n' "$OFF"
  }
  show() {
    name=$1 file=$2
    mark=
    [ "$name" = "$cur" ] && mark='*'
    mail=$(email "$file")
    fivecolor=
    vals=$(usage_get "$name" five_hour) && {
      used=${vals%% *}
      if [ -z "$best_used" ] || awk -v a="$used" -v b="$best_used" 'BEGIN { exit !(a + 0 < b + 0) }'; then
        best_used=$used
        best_name=$name
      fi
      [ "$(pct_of "$used")" -ge 100 ] 2>/dev/null && fivecolor=$RED
    }
    row "$name" "$mail" "$mark" "$fivecolor"
  }
  show default "$HOME/.claude.json"
  for d in "$HOME"/.claude-accounts/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    n=${d##*/}
    [ "$n" = default ] && continue
    valid_name "$n" || continue
    show "$n" "$d/.claude.json"
  done
  printf '\n'
  if [ -n "$best_name" ]; then
    printf 'Most 5h headroom: %s%s%s\n' "$BOLD" "$best_name" "$OFF"
  else
    printf 'Most 5h headroom: –\n'
  fi
}

usage_line() {
  f="$STATE/$1.json"
  [ -f "$f" ] || return 0
  five=$(grep -o '"five_hour":{[^}]*}' "$f" 2>/dev/null | head -n 1)
  seven=$(grep -o '"seven_day":{[^}]*}' "$f" 2>/dev/null | head -n 1)
  printf 'U\t%s\t%s\t%s\t%s\t%s\n' "$1" "$(val "$five" used)" "$(val "$five" resets_at)" "$(val "$seven" used)" "$(val "$seven" resets_at)"
}

cmd_porcelain() {
  pid=${1:-}
  case "$pid" in *[!0-9]*) pid= ;; esac
  cur=default
  if [ -n "$pid" ]; then
    d=$(ps -E -ww -p "$pid" -o command= 2>/dev/null | tr ' ' '\n' | grep '^CLAUDE_CONFIG_DIR=' | tail -n 1 | cut -d= -f2-)
    d=${d%/}
    cur=$(acct_name "${d:-$HOME/.claude}")
  fi
  printf 'C\t%s\n' "$cur"
  printf 'A\tdefault\t%s\n' "$(email "$HOME/.claude.json")"
  usage_line default
  for d in "$HOME"/.claude-accounts/*/; do
    d=${d%/}
    [ -d "$d" ] && [ "${d##*/}" != default ] || continue
    valid_name "${d##*/}" || continue
    printf 'A\t%s\t%s\n' "${d##*/}" "$(email "$d/.claude.json")"
    usage_line "${d##*/}"
  done
  if [ -n "$pid" ]; then
    sf="$HOME/.claude/sessions/$pid.json"
    if [ -f "$sf" ]; then
      sid=$(head -c 65536 "$sf" 2>/dev/null | grep -oE '"sessionId" *: *"[0-9a-fA-F-]{36}"' | grep -oE '[0-9a-fA-F-]{36}' | head -n 1)
      cwd=$(head -c 65536 "$sf" 2>/dev/null | grep -oE '"cwd" *: *"[^"]*"' | head -n 1 | sed 's/.*: *"//; s/"$//')
      [ -n "$sid" ] && [ -n "$cwd" ] && printf 'S\t%s\t%s\n' "$sid" "$cwd"
    fi
  fi
}

# A new account is a config dir of its own: everything in ~/.claude is linked in except login and
# per-session state. Session history is linked too, so every account sees the same transcripts.
make_account() {
  name=$1
  [ "$name" = default ] && { printf 'default is the ~/.claude account.\n' >&2; return 2; }
  reserved_name "$name" && { printf '%s is a cca command.\n' "$name" >&2; return 2; }
  valid_name "$name" || { printf 'Use letters, digits, - or _.\n' >&2; return 2; }
  dir="$HOME/.claude-accounts/$name"
  [ -e "$dir" ] && { printf '%s already exists.\n' "$name" >&2; return 3; }
  mkdir -p "$dir" || { printf 'Could not create %s.\n' "$dir" >&2; return 4; }
  # The shared entries are created under ~/.claude first: a missing link target would make Claude
  # Code keep a private copy inside the account folder, and the history would split.
  for x in projects file-history todos plans tasks teams paste-cache session-env sessions; do
    mkdir -p "$HOME/.claude/$x" || { rm -rf "$dir"; printf 'Could not create ~/.claude/%s.\n' "$x" >&2; return 4; }
  done
  [ -e "$HOME/.claude/history.jsonl" ] || : > "$HOME/.claude/history.jsonl" || { rm -rf "$dir"; printf 'Could not create ~/.claude/history.jsonl.\n' >&2; return 4; }
  for src in "$HOME"/.claude/* "$HOME"/.claude/.[!.]*; do
    [ -e "$src" ] || continue
    x=${src##*/}
    case "$x" in
      .credentials.json|.claude.json|shell-snapshots|statsig|ide|debug|backups|telemetry|cache|transcripts|jobs|logs|daemon*|.session-stats.json|.last-*|*.lock) continue ;;
    esac
    ln -s "$src" "$dir/$x" || { rm -rf "$dir"; printf 'Could not link %s.\n' "$x" >&2; return 5; }
  done
  return 0
}

cmd_add() {
  name=${1:-}
  make_account "$name" || exit $?
  printf 'Created ~/.claude-accounts/%s.\n' "$name"
  printf 'Log in with: cca %s\n' "$name"
}

cmd_porcelain_add() {
  name=${1:-}
  make_account "$name" || exit $?
  printf '%s\n' "$HOME/.claude-accounts/$name"
}

# Links an account made before sharing existed into the shared history. It merges into ~/.claude
# without overwriting, keeps the account's copy beside it, and only then creates the symlink.
cmd_share() {
  dry=
  name=
  for a in "$@"; do
    case "$a" in
      --dry-run) dry=1 ;;
      *) if [ -z "$name" ]; then name=$a; else die "usage: cca share [--dry-run] <name>"; fi ;;
    esac
  done
  [ "$name" = default ] && die "default is ~/.claude itself."
  reserved_name "$name" && die "$name is a cca command."
  valid_name "$name" || die "Use letters, digits, - or _."
  dir="$HOME/.claude-accounts/$name"
  [ -d "$dir" ] || die "No account $name."
  epoch=$(date +%s)
  for x in $SHARED; do
    dst="$dir/$x"
    src="$HOME/.claude/$x"
    if [ -L "$dst" ]; then
      target=$(readlink "$dst" 2>/dev/null)
      if [ "$target" = "$src" ] || [ "$dst" -ef "$src" ]; then
        printf '%-12s already shared\n' "$x"
      else
        die "$x links elsewhere: $target"
      fi
      continue
    fi
    if [ -e "$dst" ]; then
      if [ -d "$dst" ]; then
        verb=merge
      else
        verb=append
      fi
      printf '%-12s %s into ~/.claude/%s, move the copy to %s.pre-share-%s, link it\n' "$x" "$verb" "$x" "$x" "$epoch"
      if [ -z "$dry" ]; then
        [ -e "$dst.pre-share-$epoch" ] && die "$x.pre-share-$epoch already exists"
        if [ -d "$dst" ]; then
          mkdir -p "$src" || die "Could not create ~/.claude/$x"
          # BSD cp -n exits 1 when it merely skips an existing file, so judge by its message.
          msg=$( (cd "$dst" && cp -Rn . "$src/") 2>&1 >/dev/null )
          [ -z "$msg" ] || die "Could not merge $x: $msg"
        else
          [ -e "$src" ] || : > "$src" || die "Could not create ~/.claude/$x"
          cat "$dst" >> "$src" || die "Could not append $x"
        fi
        mv "$dst" "$dst.pre-share-$epoch" || die "Could not move $x aside"
        ln -s "$src" "$dst" || die "Could not link $x"
      fi
    else
      printf '%-12s link (nothing to merge)\n' "$x"
      if [ -z "$dry" ]; then
        if [ -d "$src" ]; then
          :
        elif [ "$x" = history.jsonl ]; then
          [ -e "$src" ] || : > "$src" || die "Could not create ~/.claude/$x"
        else
          mkdir -p "$src" || die "Could not create ~/.claude/$x"
        fi
        ln -s "$src" "$dst" || die "Could not link $x"
      fi
    fi
  done
  [ -n "$dry" ] && printf 'dry run: nothing changed\n'
  return 0
}

cmd_run() {
  name=$1
  shift
  reserved_name "$name" && die "$name is a cca command."
  valid_name "$name" || die "Use letters, digits, - or _."
  if [ "$name" = default ]; then
    unset CLAUDE_CONFIG_DIR
  else
    dir="$HOME/.claude-accounts/$name"
    [ -d "$dir" ] || die "No account $name. Create it with: cca add $name"
    CLAUDE_CONFIG_DIR="$dir"
    export CLAUDE_CONFIG_DIR
  fi
  command -v claude >/dev/null 2>&1 || die "claude is not on PATH."
  exec claude "$@"
}

cmd_help() {
  cat <<'EOF'
cca — Claude Code accounts

  cca, cca ls          list accounts with their usage and the most 5h headroom
  cca <name> [args…]   run claude under <name>; default means ~/.claude with
                       CLAUDE_CONFIG_DIR unset (cca work -c continues here)
  cca add <name>       create ~/.claude-accounts/<name>, sharing config and history
  cca share <name>     link the shared history into an account made before sharing
                       existed; --dry-run prints the plan first
  cca help             this text

Names: letters, digits, - and _.
Usage files: ${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower/usage/
EOF
}

case "${1:-}" in
  ''|ls) cmd_ls ;;
  help|-h|--help) cmd_help ;;
  add) shift; cmd_add "${1:-}" ;;
  share) shift; cmd_share "$@" ;;
  --porcelain) shift; cmd_porcelain "${1:-}" ;;
  --porcelain-add) shift; cmd_porcelain_add "${1:-}" ;;
  --*) die "unknown option $1" ;;
  *) cmd_run "$@" ;;
esac
